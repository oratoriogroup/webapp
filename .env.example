# Copy to .env and fill in. Never commit .env (this repository is public).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DB_PASSWORD=
# Session pooler host for the project (Supabase > Connect > Session pooler)
SUPABASE_DB_HOST=aws-0-eu-west-1.pooler.supabase.com
SUPABASE_DB_USER=postgres.zmlpagwawhwefwewfjae

# Admin access: comma separated emails allowed into /admin (in addition to the
# public.admins table). Each must also exist as a user in Supabase Auth.
ADMIN_EMAILS=

# Registration confirmation email (SMTP)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Oratorio Music <hello@oratoriogroup.org>"
MAIL_REPLY_TO=oratoriogroup@gmail.com

# Public site URL
NEXT_PUBLIC_SITE_URL=https://oratoriogroup.org

# Resend (preferred). Create in Resend > API Keys (Sending access).
RESEND_API_KEY=
